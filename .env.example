# Supabase (project: apartment-hunt)
SUPABASE_URL=https://auuwmcgbonwivkhhmpxw.supabase.co
# Dashboard -> Project Settings -> API Keys -> service_role (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com -> API Keys)
RESEND_API_KEY=

# Where the daily newsletter goes (must be the email you signed up to Resend with,
# unless you verify a custom domain)
