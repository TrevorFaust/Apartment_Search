# Digest sender. onboarding@resend.dev only delivers to your own Resend account email;
# verify a domain in Resend to email other subscribers.
EMAIL_FROM=Lease Locator <onboarding@resend.dev>
SITE_URL=https://leaselocator.vercel.app
